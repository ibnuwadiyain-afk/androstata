{
  "name": "statsapp",
  "version": "1.0.0",
  "description": "Statistical JavaScript Web App built with Capacitor for Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:init": "npx cap init StatsApp com.yourcompany.statsapp --web-dir dist",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "chart.js": "^4.4.3",
    "simple-statistics": "^7.8.3",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "vite": "^5.3.0"
  },
  "keywords": [
    "statistics",
    "capacitor",
    "android",
    "web-app",
    "apk"
  ],
  "author": "",
  "license": "MIT"
}
